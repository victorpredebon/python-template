{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "[ -z \"${COPILOT_AGENT_PROMPT:-}\" ] || .agents/hooks/session-start.sh",
        "env": {
          "AGENT_HOOK_FORMAT": "copilot"
        },
        "timeoutSec": 300
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "Bash",
        "bash": "[ -z \"${COPILOT_AGENT_PROMPT:-}\" ] || python3 .agents/hooks/guard_bash.py",
        "env": {
          "AGENT_HOOK_FORMAT": "copilot"
        },
        "timeoutSec": 30
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "matcher": "Edit|Write",
        "bash": "[ -z \"${COPILOT_AGENT_PROMPT:-}\" ] || .agents/hooks/lint-file.sh",
        "env": {
          "AGENT_HOOK_FORMAT": "copilot"
        },
        "timeoutSec": 60
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "[ -z \"${COPILOT_AGENT_PROMPT:-}\" ] || .agents/hooks/quality-gates.sh",
        "env": {
          "AGENT_HOOK_FORMAT": "copilot"
        },
        "timeoutSec": 600
      }
    ]
  }
}
